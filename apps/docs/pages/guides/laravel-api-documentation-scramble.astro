            'to' => ['required', 'string', 'max:254'],
            /**
             * The ID of the template to send.
             *
             * @example welcome
             */
            'template' => ['required', 'string', 'max:64'],
            /**
             * Values for the template's variables.
             *
             * @var array<string, string>
             *
             * @example {"name": "Ada"}
             */
            'variables' => ['sometimes', 'array'],
            'variables.*' => ['string'],
        ];
    }
}`;


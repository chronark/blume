const providerPhp = `<?php

namespace App\\Providers;

use Dedoc\\Scramble\\Scramble;
use Dedoc\\Scramble\\Support\\Generator\\OpenApi;
use Dedoc\\Scramble\\Support\\Generator\\SecurityScheme;
use Illuminate\\Support\\ServiceProvider;

class AppServiceProvider extends ServiceProvider
{
    /**
     * Register any application services.
     */
    public function register(): void
    {
        //
    }

    /**
     * Bootstrap any application services.
     */
    public function boot(): void
    {
        Scramble::configure()
            ->withDocumentTransformers(function (OpenApi $openApi) {
                $openApi->secure(
                    SecurityScheme::http('bearer')
                        ->as('bearerAuth')
                        ->setDescription('A Sanctum API token from Create a token.')
                );
            });

        // The public reference is the docs site. Keep Scramble's own UI and
        // JSON routes for local development only.
        if (! $this->app->environment('local')) {
            Scramble::configure()->expose(false);
        }
    }
}`;


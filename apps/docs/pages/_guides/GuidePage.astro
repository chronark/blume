---
// A guide's page, rendered from its entry in guides.ts with the walkthrough
// itself in the default slot, laid out like a customer story: a centered
// stack of the topic, the headline, the summary, and a byline (who wrote it
// and how long it takes to read; no dates, since guides land in batches),
// with the link back to /guides at its top-left; the guide's cover, when it
// has one; then the walkthrough in the docs' prose (`story-body`, see
// story.css) centered on the page, closing on the guide's one next step
// and a way to report a step that no longer works. The facts (what you'll
// need, what it was tested with, the example project, the docs it leans on)
// are pinned in the left column and its sections in the right. Three more
// guides from the same area and the install CTA follow.
//
// The walkthrough's `<h2>`s get ids (github-slugger, like the docs' heading
// anchors) so each section can be linked to and cited, and they make up the
// section list; the reading time is counted from the same rendered body. Each
// guide has its own static route file under guides/ rather than one `[guide]`
// route, so every page gets a generated OG card and a sitemap entry.
import PageLayout from "blume/components/layout/PageLayout.astro";
import { componentSlug } from "blume/components/slug.ts";
import { NEW_TAB_ATTRS } from "blume/core/new-tab.ts";
import data from "blume:data";
import "../_customers/story.css";
import "../_home/bloom.css";
import Footer from "../_home/Footer.astro";
import InstallBox from "../_home/InstallBox.astro";
import InstallCta from "../_home/InstallCta.astro";
import Motion from "../_home/Motion.astro";
import SectionHeading from "../_home/SectionHeading.astro";
import TextLink from "../_home/TextLink.astro";
import { glyph, installCopyScript } from "../_home/shared.ts";
import GuideGrid from "./GuideGrid.astro";
import {
  authors,
  type Guide,
  guides,
  sections as indexSections,
  topics,
} from "./guides.ts";

interface Props {
  guide: Guide;
}

const { guide } = Astro.props;
const { config } = data;
const topic = topics[guide.topic];
const author = authors[guide.author];
const route = `/guides/${guide.id}`;

const HEADING = /<h2(?<attrs>\s[^>]*)?>(?<inner>[\s\S]*?)<\/h2>/gu;
const ID_ATTR = /\sid="(?<id>[^"]+)"/u;
const TAG = /<[^>]+>/gu;
const ENTITY = /&(?:amp|lt|gt|quot|#39|#x27);/gu;
const ENTITIES: Record<string, string> = {
  "&#39;": "'",
  "&#x27;": "'",
  "&amp;": "&",
  "&gt;": ">",
  "&lt;": "<",
  "&quot;": '"',
};
const textOf = (html: string): string =>
  html
    .replaceAll(TAG, "")
    .replaceAll(ENTITY, (entity) => ENTITIES[entity] ?? entity)
    .trim();

const sections: { html: string; id: string }[] = [];
const body = (await Astro.slots.render("default")).replaceAll(
  HEADING,
  (match, attrs: string | undefined, inner: string) => {
    const existing = attrs ? ID_ATTR.exec(attrs)?.groups?.id : undefined;
    const id = existing ?? componentSlug(textOf(inner));
    sections.push({ html: inner.replaceAll(TAG, ""), id });
    return existing ? match : `<h2 id="${id}"${attrs ?? ""}>${inner}</h2>`;
  }
);
const minutes = Math.max(
  1,
  Math.round(textOf(body).split(/\s+/u).filter(Boolean).length / 230)
);

// A new issue on the repository, titled for the guide and linking to it.
const pageUrl = config.site ? new URL(route, config.site).href : route;
const reportHref = config.repoUrl
  ? `${config.repoUrl}/issues/new?${new URLSearchParams({
      body: `Guide: ${pageUrl}\n\nWhich step:\n\nWhat happened:\n\nBlume version:\n`,
      title: `Guide: ${guide.title}`,
    })}`
  : null;

// Three more guides, so every page ends on more: the ones after this one in
// its own index section first (wrapping to the start), then the rest.
const index = guides.findIndex((entry) => entry.id === guide.id);
const sectionTopics = indexSections.find((section) =>
  section.topics.includes(guide.topic)
)?.topics ?? [guide.topic];
const others = [...guides.slice(index + 1), ...guides.slice(0, index)];
const more = [
  ...others.filter((entry) => sectionTopics.includes(entry.topic)),
  ...others.filter((entry) => !sectionTopics.includes(entry.topic)),
].slice(0, 3);
const link =
  "text-foreground underline decoration-foreground/20 underline-offset-4 hover:decoration-foreground";
---

<PageLayout
  analytics={config.analytics}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  lastModified={guide.updated ?? guide.published}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  page={{
    description: guide.meta.description,
    route,
    title: guide.meta.title,
  }}
  searchEnabled={config.search.enabled}
  site={{ description: config.description, title: config.title }}
  siteUrl={config.site}
  structuredDataEnabled={config.structuredData}
  themeMode={config.theme.mode}
  x={config.x}
>
  <div
    class="mx-auto grid max-w-[1400px] gap-24 px-6 pb-20 sm:pb-24 lg:gap-32 xl:gap-40"
  >
    <article class="flex flex-col gap-12 pt-16 sm:pt-24 lg:gap-16">
      <!-- The back link floats at the header's top-left from `lg` up, flush
           with the facts column, level with the topic; below that it leads
           the stack on its own line. -->
      <header class="relative flex flex-col items-center gap-6 text-center">
        <a
          class="inline-flex items-center gap-1 self-start text-muted-foreground text-sm hover:text-foreground max-lg:mb-2 lg:absolute lg:top-0 lg:left-0"
          href="/guides"
        >
          <svg
            aria-hidden="true"
            class="size-3.5 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            set:html={glyph("chevron-left")}
          />
          Guides
        </a>
        <p class="flex items-center gap-2 font-medium text-accent text-sm">
          <svg
            aria-hidden="true"
            class="size-4 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            viewBox="0 0 24 24"
            set:html={glyph(topic.icon)}
          />
          {topic.label}
        </p>
        <h1
          class="max-w-[22ch] text-balance font-medium text-4xl sm:text-5xl lg:text-6xl"
        >
          {guide.title}
        </h1>
        <p
          class="max-w-[52ch] text-pretty text-lg text-muted-foreground sm:text-xl"
        >
          {guide.summary}
        </p>
        <p
          class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-muted-foreground text-sm"
        >
          <span>
            By{" "}
            <a
              class="text-foreground hover:underline"
              href={author.href}
              rel="author"
              {...NEW_TAB_ATTRS}>{author.name}</a
            >
          </span>
          <span aria-hidden="true">·</span>
          <span>{minutes} min read</span>
        </p>
      </header>

      {
        guide.image && (
          <div class="relative aspect-[2/1] overflow-hidden rounded-[28px] bg-muted outline-1 -outline-offset-1 outline-foreground/5">
            <img
              alt={guide.image.alt ?? ""}
              class="absolute inset-0 size-full object-cover"
              decoding="async"
              src={guide.image.src}
            />
          </div>
        )
      }

      <!-- From `lg` up the guide sits in the page's center column, the facts
           in the left one and its sections in the right, both pinned while
           it scrolls. Below `lg` the facts sit above it, two to a row, and
           the section list drops out. -->
      <div
        class:list={[
          "grid gap-x-12 gap-y-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,40rem)_minmax(0,1fr)]",
          !guide.image && "border-border border-t pt-12 lg:pt-16",
        ]}
      >
        <aside
          class="max-lg:mx-auto max-lg:w-full max-lg:max-w-[40rem] lg:sticky lg:top-28 lg:max-w-56 lg:self-start"
        >
          <dl class="grid grid-cols-2 gap-x-8 gap-y-6 text-sm lg:grid-cols-1">
            <div class="flex flex-col gap-1">
              <dt class="text-muted-foreground text-sm">You'll need</dt>
              <dd>
                <ul class="flex flex-col gap-1 text-foreground" role="list">
                  {guide.prerequisites.map((item) => <li>{item}</li>)}
                </ul>
              </dd>
            </div>
            {
              guide.tested && (
                <div class="flex flex-col gap-1">
                  <dt class="text-muted-foreground text-sm">Tested with</dt>
                  <dd class="text-foreground">
                    Blume {guide.tested.version}
                  </dd>
                </div>
              )
            }
            {
              (guide.example?.repo || guide.example?.demo) && (
                <div class="flex flex-col gap-1">
                  <dt class="text-muted-foreground text-sm">Example</dt>
                  <dd>
                    <ul class="flex flex-col gap-1" role="list">
                      {guide.example.repo && (
                        <li>
                          <a
                            class={link}
                            href={guide.example.repo}
                            {...NEW_TAB_ATTRS}
                          >
                            Source code
                          </a>
                        </li>
                      )}
                      {guide.example.demo && (
                        <li>
                          <a
                            class={link}
                            href={guide.example.demo}
                            {...NEW_TAB_ATTRS}
                          >
                            Live demo
                          </a>
                        </li>
                      )}
                    </ul>
                  </dd>
                </div>
              )
            }
            <div class="flex flex-col gap-1">
              <dt class="text-muted-foreground text-sm">In the docs</dt>
              <dd>
                <ul class="flex flex-col gap-1" role="list">
                  {
                    guide.docs.map((doc) => (
                      <li>
                        <a class={link} href={doc.href}>
                          {doc.label}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div
          class="flex min-w-0 flex-col gap-12 max-lg:mx-auto max-lg:w-full max-lg:max-w-[40rem]"
        >
          <div
            class="story-body prose max-w-none [&_h2]:scroll-mt-28 [&_h3]:scroll-mt-28"
            set:html={body}
          />

          <!-- The guide's one next step, in the homepage's muted surface -->
          <section
            aria-labelledby="next-step"
            class="flex flex-col items-start gap-4 rounded-[28px] bg-muted p-6 inset-ring inset-ring-foreground/5 sm:p-8"
          >
            <p class="font-medium text-accent text-sm">Next step</p>
            <h2
              class="text-balance font-medium text-2xl text-foreground"
              id="next-step"
            >
              {guide.nextStep.title}
            </h2>
            <p class="text-pretty text-muted-foreground">
              {guide.nextStep.body}
            </p>
            {
              guide.nextStep.command && (
                <InstallBox class="max-w-md" command={guide.nextStep.command} />
              )
            }
            {
              guide.nextStep.link && (
                <TextLink href={guide.nextStep.link.href}>
                  {guide.nextStep.link.label}
                </TextLink>
              )
            }
          </section>

          {
            reportHref && (
              <p class="text-muted-foreground text-sm">
                A step here not working for you?{" "}
                <a class={link} href={reportHref} {...NEW_TAB_ATTRS}>
                  Report a broken step
                </a>
                .
              </p>
            )
          }
        </div>

        {
          sections.length > 1 && (
            <nav
              aria-label="On this page"
              class="max-lg:hidden lg:sticky lg:top-28 lg:max-w-56 lg:self-start lg:justify-self-end"
            >
              <p class="text-muted-foreground text-sm">On this page</p>
              <ul class="mt-2 flex flex-col gap-2 text-sm" role="list">
                {sections.map((section) => (
                  <li>
                    <a
                      class="text-foreground/80 hover:text-foreground"
                      href={`#${section.id}`}
                      set:html={section.html}
                    />
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
    </article>

    {
      more.length > 0 && (
        <section class="flex flex-col gap-10 lg:gap-12" data-reveal>
          <SectionHeading tagline="More guides." title="Keep going.">
            <TextLink href="/guides">All guides</TextLink>
          </SectionHeading>
          <GuideGrid guides={more} />
        </section>
      )
    }

    <InstallCta />
  </div>
  <!-- After the sections, so their reveal containers exist when it arms -->
  <Motion />
  <script is:inline set:html={installCopyScript} />
  <Footer slot="footer" />
</PageLayout>

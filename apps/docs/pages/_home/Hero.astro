---
// Landing hero on the plain page: the launch badge, the two-tone headline,
// the tagline, and the install box with its two paths (get started, or
// migrate existing docs). Beneath, the product preview stands in a rounded
// bloom panel — pale at the top, deepening to cornflower toward the bottom
// (see bloom.css) — the same language as the feature trays further down,
// running off the panel's lower edge. The install box copy button uses the
// page-level delegated `data-blume-copy-install` handler in index.astro.
import "./bloom.css";
import InstallBox from "./InstallBox.astro";
import ProductPreview from "./ProductPreview.astro";
import TextLink from "./TextLink.astro";
---

<section class="pt-16 pb-16 sm:pt-24 sm:pb-20">
  <div class="mx-auto max-w-[1400px] px-6">
    <a
      class="inline-flex items-center py-1 text-muted-foreground text-xs hover:text-foreground"
      href="/changelog/blume-2-1-0"
    >
      Introducing Blume 2.1
    </a>
    <h1
      class="mt-6 max-w-3xl text-balance font-medium text-4xl sm:text-5xl lg:text-6xl"
    >
      <span class="block">The open-source</span>
      <span class="block">docs framework</span>
      <span class="block text-muted-foreground">for humans and agents</span>
    </h1>

    <!-- Tagline, then the install command with the two paths beside it -->
    <p class="mt-8 max-w-xl text-pretty text-lg text-muted-foreground">
      Fast, AI-ready, and zero-config. Drop Markdown into a folder and ship a
      production-grade docs site with no app boilerplate to write or maintain.
      Free and open source, forever.
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <div class="w-full max-w-xs"><InstallBox /></div>
      <div class="flex items-center gap-6">
        <TextLink href="/docs/quickstart">Get started</TextLink>
        <TextLink href="#migrate">Migrate your docs</TextLink>
      </div>
    </div>
  </div>

  <div class="mx-auto mt-16 max-w-[1400px] px-6 sm:mt-20">
    <div
      class="hero-bloom relative overflow-hidden rounded-[28px] px-3 pt-8 after:pointer-events-none after:absolute after:inset-0 after:rounded-[inherit] after:inset-ring after:inset-ring-foreground/10 sm:px-10 sm:pt-14 lg:px-16 lg:pt-16"
    >
      <ProductPreview />
    </div>
  </div>
</section>

<style>
  /* Pale petal at the top, gathering into cornflower at the bottom-center,
     behind the foot of the preview. The panel's edge is drawn on top (the
     `after:` ring) so it still closes the preview off where the window runs
     off the bottom. */
  .hero-bloom {
    background-color: color-mix(in oklab, var(--bloom-7) 30%, var(--blume-background));
    background-image:
      radial-gradient(
        70% 60% at 50% 100%,
        color-mix(in oklab, var(--bloom-4) 85%, transparent),
        transparent 75%
      ),
      radial-gradient(
        120% 90% at 50% 100%,
        color-mix(in oklab, var(--bloom-6) 80%, transparent),
        transparent 80%
      );
  }
</style>
